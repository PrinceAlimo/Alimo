# ============================================================
# TEMPLATE — copy this file to `.env` and fill in real values.
# (`.env` is git-ignored; this template is committed so setup
# docs stay in the repo without leaking secrets.)
#
# Rule: only `VITE_`-prefixed vars reach the browser bundle.
#  -> Secrets           = NO prefix
#  -> Public site info  = VITE_ prefix
# ============================================================

# --- Private secrets (no prefix) ---
GITHUB_TOKEN=
SMTP_PASSWORD=

# --- Public site config (VITE_ prefix) ---
VITE_SITE_URL=
VITE_PUBLIC_GITHUB=
